spring.application.name=power-inspection-backend
server.port=8080

# Tomcat 配置 - 增加请求头大小限制
server.tomcat.max-http-header-size=10MB
server.tomcat.max-http-form-post-size=100MB

# 数据库配置
# 如果使用 MobaXterm SSH 隧道，可能需要修改端口为 3307
# 注意：characterEncoding 使用 UTF-8（Java 支持的名称），MySQL 会自动转换为 utf8mb4
spring.datasource.url=jdbc:mysql://localhost:3306/power_inspection?useSSL=false&serverTimezone=Asia/Shanghai&characterEncoding=UTF-8&collation=utf8mb4_unicode_ci&allowPublicKeyRetrieval=true&useUnicode=true
spring.datasource.username=root
spring.datasource.password=YOUR_DB_PASSWORD
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

# JPA 配置
spring.jpa.hibernate.ddl-auto=update
spring.jpa.database-platform=org.hibernate.dialect.MySQLDialect
spring.jpa.show-sql=false
spring.jpa.properties.hibernate.format_sql=false

# Jackson JSON 序列化配置 - 确保 UTF-8 编码
spring.jackson.default-property-inclusion=non_null
spring.jackson.serialization.write-dates-as-timestamps=false
spring.jackson.serialization.indent-output=false

# HTTP 编码配置
server.servlet.encoding.charset=UTF-8
server.servlet.encoding.enabled=true
server.servlet.encoding.force=true
server.servlet.encoding.force-request=true
server.servlet.encoding.force-response=true

# 华为云 ModelArts API 配置
huaweicloud.api.key=YOUR_HUAWEI_CLOUD_API_KEY
huaweicloud.endpoint=http://api-cn-southwest-2.modelarts-infer.com/v2/infer/YOUR_SERVICE_ID/v1/chat/completions
huaweicloud.service.id=YOUR_SERVICE_ID

# 日志配置
logging.level.com.powerinspection=INFO
logging.level.org.springframework.web=WARN
logging.level.org.hibernate.SQL=WARN
logging.level.org.hibernate.type.descriptor.sql.BasicBinder=WARN
logging.level.com.jcraft.jsch=WARN

# 文件导入配置
defect.import.folder=D:/Desktop/example_responses

# SFTP 远程连接配置（使用密码认证）
sftp.enabled=true
sftp.host=YOUR_SFTP_HOST
sftp.port=22
sftp.username=YOUR_SFTP_USERNAME
sftp.password=YOUR_SFTP_PASSWORD
sftp.private.key.path=
sftp.remote.path=/home/YOUR_USER/rtdetrv2_mindspore/results/dual_detection/

# 自动导入配置
auto.import.enabled=true
auto.import.interval=30000

# 官方验证码配置（注册/找回密码）
auth.official.registration-code=YOUR_REGISTRATION_CODE
auth.official.reset-code=YOUR_RESET_CODE
